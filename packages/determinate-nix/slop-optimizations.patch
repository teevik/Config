+        /* Note: `Expr`s are never freed and not GC-allocated, so the
+           batch needs no rooting. */
+        executor->spawnSpeculative(
+            makeWork([batch(std::move(batch)), this]() {
+                for (auto p : batch) {
+                    if (executor->quit)
