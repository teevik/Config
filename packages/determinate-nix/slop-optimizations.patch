+void Executor::spawnSpeculative(work_t && work, SpeculationKind kind)
+{
+    auto & counter = outstanding(kind);
+    auto & max = kind == SpeculationKind::Thunk ? maxSpeculativeOutstanding : maxInstantiationsOutstanding;
