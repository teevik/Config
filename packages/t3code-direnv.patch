+
+describe("makeProviderEnvironmentResolver", () => {
+  it.effect("captures an interactive shell environment in the project cwd", () =>
+    Effect.gen(function* () {
+      const fixture = NodeFS.mkdtempSync(NodePath.join(NodeOS.tmpdir(), "t3-project-shell-"));
+      yield* Effect.addFinalizer(() =>
+        Effect.sync(() => NodeFS.rmSync(fixture, { recursive: true, force: true })),
+      );
+      const workspace = NodePath.join(fixture, "workspace");
+      const shell = NodePath.join(fixture, "project-shell");
+      const hostShell = process.env.SHELL;
+      assert.ok(hostShell);
+      NodeFS.mkdirSync(workspace);
+      NodeFS.writeFileSync(
+        shell,
+        [
+          `#!${hostShell}`,
+          'export PROJECT_MARKER="loaded"',
+          'export PROJECT_CWD="$PWD"',
+          `exec ${hostShell}`,
+        ].join("\n"),
+      );
+      NodeFS.chmodSync(shell, 0o755);
+
+      const resolve = makeProviderEnvironmentResolver(undefined, {
+        ...process.env,
+        SHELL: shell,
+      });
+      const environment = yield* resolve(workspace);
+
+      assert.strictEqual(environment.PROJECT_MARKER, "loaded");
+      assert.strictEqual(environment.PROJECT_CWD, workspace);
+    }),
+  );
+
+  it.effect("loads the cwd environment and applies provider overrides last", () =>
+    Effect.gen(function* () {
+      let receivedCwd: string | undefined;
+      const resolve = makeProviderEnvironmentResolver(
+        [{ name: "API_KEY", value: "configured", sensitive: true }],
+        { API_KEY: "inherited", PATH: "/bin", REMOVE_ME: "yes" },
+        (cwd) => {
+          receivedCwd = cwd;
+          return Effect.succeed({ API_KEY: "project", PATH: "/project/bin" });
+        },
+      );
+
+      const environment = yield* resolve("/workspace/project");
+
+      assert.strictEqual(receivedCwd, "/workspace/project");
+      assert.deepStrictEqual(environment, { API_KEY: "configured", PATH: "/project/bin" });
+    }),
+  );
+
+  it.effect("falls back to the inherited environment when shell activation fails", () =>
+    Effect.gen(function* () {
+      const resolve = makeProviderEnvironmentResolver(
+        [{ name: "API_KEY", value: "configured", sensitive: true }],
+        { PATH: "/bin" },
+        () => Effect.fail(new Error("shell activation unavailable")),
+      );
+
+      assert.deepStrictEqual(yield* resolve("/workspace/project"), {
+        API_KEY: "configured",
+        PATH: "/bin",
+      });
+    }),
+  );
