+
+export type ProviderEnvironmentResolver = (cwd: string) => Effect.Effect<NodeJS.ProcessEnv, never>;
+
+type ProjectShellEnvironment = Record<string, string>;
+
+const ENVIRONMENT_CAPTURE_START = "__T3CODE_PROJECT_ENVIRONMENT_START__";
+const ENVIRONMENT_CAPTURE_END = "__T3CODE_PROJECT_ENVIRONMENT_END__";
+const POSIX_CAPTURE_COMMAND = `printf '\0%s\0' '${ENVIRONMENT_CAPTURE_START}'; env -0; printf '%s\0' '${ENVIRONMENT_CAPTURE_END}'`;
+const WINDOWS_CAPTURE_COMMAND = [
+  `[Console]::Out.Write([char]0 + '${ENVIRONMENT_CAPTURE_START}' + [char]0)`,
+  "Get-ChildItem Env: | ForEach-Object { [Console]::Out.Write($_.Name + '=' + $_.Value + [char]0) }",
+  `[Console]::Out.Write('${ENVIRONMENT_CAPTURE_END}' + [char]0)`,
+].join("; ");
+
+function parseCapturedEnvironment(output: string): ProjectShellEnvironment | undefined {
+  const entries = output.split("\0");
+  const start = entries.indexOf(ENVIRONMENT_CAPTURE_START);
+  const end = entries.indexOf(ENVIRONMENT_CAPTURE_END, start + 1);
+  if (start === -1 || end === -1) return undefined;
+
+  const environment: ProjectShellEnvironment = {};
+  for (const entry of entries.slice(start + 1, end)) {
+    const separator = entry.indexOf("=");
+    if (separator <= 0) continue;
+    environment[entry.slice(0, separator)] = entry.slice(separator + 1);
+  }
+  return environment;
+}
