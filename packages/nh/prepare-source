#!/usr/bin/env bash
# Companion to source-hook.patch. Only plain local references to
# this checkout use the existing Git-aware snapshot; other references pass through.
set -euo pipefail

if (( $# != 2 )); then
    printf 'Usage: nh-prepare-source CONFIG_ROOT FLAKE_REFERENCE\n' >&2
    exit 64
fi

config_root="$(realpath -- "$1")"
reference=$2

if [[ -d "$reference" && "$(realpath -- "$reference")" == "$config_root" ]]; then
    snapshot="$(nix eval --impure --raw --file "$config_root/modules/nixos/minimal/source-snapshot.nix")"
    printf 'path:%s\n' "$snapshot"
else
    printf '%s\n' "$reference"
fi
