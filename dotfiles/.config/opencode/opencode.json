{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "agents": {
    "build": {
      "model": "openai/gpt-5.6-sol-fast#max"
    },
    "plan": {
      "model": "openai/gpt-5.6-sol-fast#max"
    },
    "general": {
      "model": "openai/gpt-5.6-sol-fast#max"
    },
    "explore": {
      "model": "openai/gpt-5.6-sol-fast#max"
    },
    "compaction": {
      "model": "openai/gpt-5.6-sol-fast#max"
    },
    "summary": {
      "model": "openai/gpt-5.6-sol-fast#max"
    },
    "title": {
      "model": "openai/gpt-5.6-sol-fast#low"
    }
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/nix/store/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/var/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/repos/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/tool-output/*", "effect": "allow" }
  ]
}
