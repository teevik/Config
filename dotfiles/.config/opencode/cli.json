{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin",
    "mode": "system"
  },
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": false
  },
  "diffs": {
    "source": "branch",
    "wrap": "word",
    "tree": true,
    "single": false,
    "view": "auto"
  },
  "tabs": {
    "enabled": true,
    "scope": "cwd",
    "layout": "horizontal",
    "indicators": "numbers"
  },
  "terminal": {
    "title": true,
    "copy": "select"
  },
  "prompt": {
    "editor": true,
    "paste": "compact",
    "image_preview": true
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "show",
    "tps": true,
    "markdown": "rendered",
    "new_location": "launch"
  },
  "animations": true
}
