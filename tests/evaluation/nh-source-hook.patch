+use std::{
+  path::Path,
+  process::{Command, Stdio},
+};
+
+use color_eyre::eyre::{Result, WrapErr, ensure};
+use nh_installable::Installable;
+
+/// Run an explicitly configured source preparer, preserving selected
+/// attributes.
+///
+/// # Errors
+///
+/// Returns an error if the program cannot run, fails, or prints invalid output.
+pub fn prepare(
+  mut installable: Installable,
+  program: Option<&Path>,
+) -> Result<Installable> {
+  let Some(program) = program else {
+    return Ok(installable);
+  };
+  let Installable::Flake { reference, .. } = &mut installable else {
+    return Ok(installable);
+  };
+
+  let output = Command::new(program)
+    .arg(&*reference)
+    .stdin(Stdio::null())
+    .stderr(Stdio::inherit())
+    .output()
+    .wrap_err_with(|| {
+      format!("Failed to run flake source command {}", program.display())
+    })?;
+  ensure!(
+    output.status.success(),
+    "Flake source command {} failed: {}",
+    program.display(),
+    output.status
+  );
+  let output = String::from_utf8(output.stdout)
+    .wrap_err("Flake source command output is not UTF-8")?;
+  let replacement = output.strip_suffix('\n').unwrap_or(&output);
+  let replacement = replacement.strip_suffix('\r').unwrap_or(replacement);
+  ensure!(
+    !replacement.trim().is_empty()
+      && !replacement.contains(['\n', '\r', '\0', '#']),
+    "Flake source command must print one reference without an attribute \
+     fragment"
+  );
+  replacement.clone_into(reference);
+  Ok(installable)
+}
+
+#[cfg(all(test, unix))]
+mod tests {
+  use std::{fs, os::unix::fs::PermissionsExt, path::PathBuf};
+
+  use color_eyre::eyre::{Result, ensure};
+  use nh_installable::Installable;
+
+  use super::prepare;
+
+  fn flake(reference: &str) -> Installable {
+    Installable::Flake {
+      reference: reference.to_owned(),
+      attribute: vec!["nixosConfigurations".into(), "host.with.dot".into()],
+    }
+  }
+
+  fn helper(body: &str) -> Result<(tempfile::TempDir, PathBuf)> {
+    let directory = tempfile::tempdir()?;
+    let path = directory.path().join("source command with spaces");
+    fs::write(&path, format!("#!/bin/sh\n{body}\n"))?;
+    fs::set_permissions(&path, fs::Permissions::from_mode(0o700))?;
+    Ok((directory, path))
+  }
+
+  #[test]
+  fn passes_one_literal_argument_and_preserves_attributes() -> Result<()> {
+    let reference = "path:/a b/$(exit 99);'\"";
+    let (_directory, program) =
+      helper("test \"$#\" -eq 1 || exit 2\nprintf '%s\\n' \"$1\"")?;
+    let prepared = prepare(flake(reference), Some(&program))?;
+    ensure!(matches!(
+      &prepared,
+      Installable::Flake { reference: actual, attribute }
+        if actual == reference
+          && attribute.as_slice() == ["nixosConfigurations", "host.with.dot"]
+    ));
+    Ok(())
+  }
+
+  #[test]
+  fn substitutes_reference_from_stdout() -> Result<()> {
+    let (_directory, program) =
+      helper("printf 'path:/nix/store/prepared-source\\n'")?;
+    let prepared = prepare(flake("/working/tree"), Some(&program))?;
+    ensure!(matches!(
+      &prepared,
+      Installable::Flake { reference, attribute }
+        if reference == "path:/nix/store/prepared-source"
+          && attribute.as_slice() == ["nixosConfigurations", "host.with.dot"]
+    ));
+    Ok(())
+  }
+
+  #[test]
+  fn rejects_failures_and_invalid_output() -> Result<()> {
+    for body in [
+      "printf 'path:/valid\\n'; exit 1",
+      "printf ''",
+      "printf '   \\n'",
+      "printf 'first\\nsecond\\n'",
+      "printf 'path:/valid#wrong.attribute\\n'",
+      "printf 'path:/valid\\000bad'",
+      "printf '\\377'",
+    ] {
+      let (_directory, program) = helper(body)?;
+      ensure!(prepare(flake("/working/tree"), Some(&program)).is_err());
+    }
+    Ok(())
+  }
+
+  #[test]
+  fn missing_program_fails_for_flakes_only() -> Result<()> {
+    let directory = tempfile::tempdir()?;
+    let missing = directory.path().join("missing");
+    ensure!(prepare(flake("/working/tree"), Some(&missing)).is_err());
+    for installable in [
+      Installable::File {
+        path:      "configuration.nix".into(),
+        attribute: vec![],
+      },
+      Installable::Expression {
+        expression: "{}".into(),
+        attribute:  vec![],
+      },
+      Installable::Store {
+        path: "/nix/store/example".into(),
+      },
+    ] {
+      prepare(installable, Some(&missing))?;
+    }
+    prepare(flake("/working/tree"), None)?;
+    Ok(())
+  }
+}
